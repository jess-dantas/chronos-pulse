# Copie este arquivo para `.env` e preencha com valores reais antes de subir com Docker:
#   cp .env.example .env
#
# ATENÇÃO: não commite o arquivo `.env`.

# Obrigatório — usada para assinar os JWTs.
# Use valor longo e aleatório (ex.: `openssl rand -base64 48`). Vale para dev e prod.
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Opcional — e-mail (usado para notificações/recuperação de senha).
# Se deixar vazio, o disparo de e-mails fica desativado (CHRONOS_MAIL_ENABLED=false).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CHRONOS_MAIL_ENABLED=false
CHRONOS_MAIL_FROM=no-reply@chronospulse.com.br

# Opcional — em quais querys CORS a API responderá (separadas por vírgula).
# CHRONOS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173