# Chronos Pulse - configuração on-prem (copie para .env e ajuste).
# Os lançadores criam um .env mínimo automaticamente no primeiro uso.

# OBRIGATÓRIO - segredo de assinatura dos tokens JWT (mín. 32 bytes).
JWT_SECRET=TROCAR_POR_UM_SEGREDO_FORTE_32_BYTES

# Postgres (usado pelo docker-compose.yml e pelo app).
POSTGRES_USER=chronos_user
POSTGRES_PASSWORD=TROCAR_POR_UMA_SENHA_FORTE
POSTGRES_DB=chronos_db
POSTGRES_PORT=5432

# Porta HTTP do servidor.
PORT=8080

# E-mail (comprovante de ponto, recuperação de senha). Desligado por padrão no on-prem.
# CHRONOS_MAIL_ENABLED=false
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# Mantém o /actuator/health "UP" mesmo sem SMTP configurado; reative se usar e-mail real.
# MANAGEMENT_HEALTH_MAIL_ENABLED=false

# CORS para o app web / cliente (origens separadas por vírgula).
# CHRONOS_ALLOWED_ORIGINS=http://localhost:8080

# Assinatura digital CAdES (.p7s) do AFD/AEJ - Portaria MTP 671/2021.
# Use o Base64 do PFX do certificado ICP-Brasil (e-CNPJ).
# FISCAL_PFX_BASE64=
# FISCAL_PFX_SENHA=

# Telemetria (logs de login / tentativas).
# TELEMETRIA_ENABLED=true
# TELEMETRIA_RETENTION_DIAS=30